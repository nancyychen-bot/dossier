# Auth — set both to random strings in production
DOSSIER_PASSWORD=your_login_password
DOSSIER_SECRET=your_random_hmac_secret

# Notion — source of truth for all contact data
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Anthropic — voice capture, AI search, draft email
ANTHROPIC_API_KEY=your_anthropic_api_key

# Vercel Blob — photo uploads
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Enrichment (optional)
CLEARBIT_API_KEY=your_clearbit_key
PDL_API_KEY=your_pdl_api_key
