# Auth — set both to your own values
DOSSIER_PASSWORD=your_login_password
DOSSIER_SECRET=your_random_hmac_secret

# Notion — backend database for all contact data
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Anthropic — powers voice capture, AI search, and draft email
ANTHROPIC_API_KEY=your_anthropic_api_key

# Vercel Blob — photo uploads (get this from your Vercel project)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
